{
  "clearMocks": true,
  "moduleFileExtensions": ["js", "ts"],
  "testMatch": ["**/*.test.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^p-limit$": "<rootDir>/__mocks__/p-limit.js"
  },
  "setupFiles": ["<rootDir>/__mocks__/setup-node-globals.js"],
  "verbose": true
}